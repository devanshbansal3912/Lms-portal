# ==============================================================================
# AI-Powered LMS Environment Variables Template (Student 3 Module)
# Copy this file to .env.local and update the values. Never commit .env.local!
# ==============================================================================

# Supabase Configuration
# Provided by Student 1 / Supabase Admin Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Side Secret Key (DO NOT expose in client code with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Dify AI Orchestration Backend
# Provided by Student 2 (Docker VM IP / Cloud endpoint / Colab tunnel URL)
# Example: http://192.168.1.100/v1 or https://dify.yourdomain.com/v1
DIFY_API_BASE_URL=http://localhost/v1

# App-specific API Keys generated inside Dify Studio for Student 3's Workflows
# Studio -> Your Quiz Workflow App -> API Access -> API Key
DIFY_QUIZ_API_KEY=app-yourQuizWorkflowApiKeyHere

# Studio -> Your Flashcard Workflow App -> API Access -> API Key
DIFY_FLASHCARD_API_KEY=app-yourFlashcardWorkflowApiKeyHere

# Optional: Set to 'true' to force mock mode for local testing without calling Dify
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true
